generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BalanceType {
  credit
  debit
  none
}

enum AdjustmentType {
  increase
  decrease
}

model companies {
  id           Int      @id @default(autoincrement())
  company_name String
  address      String?
  contact      String?
  email        String?
  logo         String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
}

model users {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role_id    Int
  phone      String?
  status     Boolean  @default(true)
  created_at DateTime @default(now())

  role roles @relation(fields: [role_id], references: [id])

  audit_logs  audit_logs[]
  report_logs report_logs[]
}

model roles {
  id          Int     @id @default(autoincrement())
  role_name   String
  description String?

  users            users[]
  role_permissions role_permissions[]
}

model permissions {
  id              Int    @id @default(autoincrement())
  module          String
  permission_name String

  role_permissions role_permissions[]
}

model role_permissions {
  id            Int @id @default(autoincrement())
  role_id       Int
  permission_id Int

  role       roles       @relation(fields: [role_id], references: [id])
  permission permissions @relation(fields: [permission_id], references: [id])
}

model categories {
  id            Int       @id @default(autoincrement())
  category_name String
  description   String?
  created_at    DateTime  @default(now())
  updated_at    DateTime?

  products products[]
}

model products {
  id               Int       @id @default(autoincrement())
  category_id      Int
  product_code     String
  product_name     String
  description      String?
  image            String?
  has_expire_date  Boolean   @default(false)
  expire_date      DateTime?
  opening_quantity Int
  minimum_sale_quantity Int  @default(0)
  stock_alert      Int       @default(0)
  purchase_cost    Decimal
  sale_cost        Decimal
  reorder_level    Int
  created_at       DateTime  @default(now())

  category categories @relation(fields: [category_id], references: [id])

  purchase_items        purchase_items[]
  sale_items            sale_items[]
  purchase_return_items purchase_return_items[]
  sales_return_items    sales_return_items[]
  stock_adjustments     stock_adjustments[]
}

model suppliers {
  id              Int         @id @default(autoincrement())
  full_name       String
  address         String?
  mobile_no       String?
  email           String?
  opening_balance Decimal?
  balance_type    BalanceType
  registered_date DateTime
  created_at      DateTime    @default(now())

  supplier_payments supplier_payments[]
  purchases         purchases[]
  purchase_returns  purchase_returns[]
}

model supplier_payments {
  id           Int      @id @default(autoincrement())
  supplier_id  Int
  purchase_id  Int?
  payment_mode String
  amount       Decimal
  remarks      String?
  payment_date DateTime

  supplier suppliers @relation(fields: [supplier_id], references: [id])
}

model sponsors {
  id              Int      @id @default(autoincrement())
  full_name       String
  gender          String?
  address         String?
  mobile_no       String?
  email           String?
  registered_date DateTime

  customers customers[]
}

model customers {
  id              Int         @id @default(autoincrement())
  full_name       String
  gender          String?
  address         String?
  mobile_no       String?
  email           String?
  customer_type   String?
  sponsor_id      Int?
  opening_balance Decimal?
  balance_type    BalanceType
  registered_date DateTime
  created_at      DateTime    @default(now())

  sponsor sponsors? @relation(fields: [sponsor_id], references: [id])

  receipts      customer_receipts[]
  sales         sales[]
  sales_returns sales_returns[]
}

model customer_receipts {
  id           Int      @id @default(autoincrement())
  customer_id  Int
  invoice_no   Int
  payment_mode String
  amount       Decimal
  remarks      String?
  created_at   DateTime

  customer customers @relation(fields: [customer_id], references: [id])
}

model purchases {
  id                 Int      @id @default(autoincrement())
  transaction_number String
  supplier_id        Int
  purchase_date      DateTime
  payment_mode       String
  cash_amount        Decimal
  total              Decimal
  discount           Decimal
  grand_total        Decimal
  paid               Decimal
  rest               Decimal
  created_at         DateTime @default(now())

  supplier suppliers @relation(fields: [supplier_id], references: [id])

  purchase_items purchase_items[]
}

model purchase_items {
  id          Int       @id @default(autoincrement())
  purchase_id Int
  product_id  Int
  expire_date DateTime?
  cost        Decimal
  quantity    Int
  price       Decimal
  amount      Decimal

  purchase purchases @relation(fields: [purchase_id], references: [id])
  product  products  @relation(fields: [product_id], references: [id])
}

model purchase_returns {
  id             Int      @id @default(autoincrement())
  transaction_no String
  purchase_id    Int
  supplier_id    Int
  return_type    String
  return_date    DateTime
  total_amount   Decimal

  supplier suppliers @relation(fields: [supplier_id], references: [id])

  purchase_return_items purchase_return_items[]
}

model purchase_return_items {
  id                 Int     @id @default(autoincrement())
  purchase_return_id Int
  product_id         Int
  quantity           Int
  amount             Decimal

  purchase_return purchase_returns @relation(fields: [purchase_return_id], references: [id])
  product         products         @relation(fields: [product_id], references: [id])
}

model sales {
  id           Int      @id @default(autoincrement())
  invoice_no   String
  customer_id  Int
  invoice_date DateTime
  total        Decimal
  discount     Decimal
  grand_total  Decimal
  paid         Decimal
  rest         Decimal
  created_at   DateTime @default(now())

  customer customers @relation(fields: [customer_id], references: [id])

  sale_items sale_items[]
}

model sale_items {
  id         Int     @id @default(autoincrement())
  sale_id    Int
  product_id Int
  quantity   Int
  price      Decimal
  total      Decimal

  sale    sales    @relation(fields: [sale_id], references: [id])
  product products @relation(fields: [product_id], references: [id])
}

model sales_returns {
  id             Int      @id @default(autoincrement())
  transaction_no String
  sale_id        Int
  customer_id    Int
  return_date    DateTime
  total_amount   Decimal

  customer customers @relation(fields: [customer_id], references: [id])

  sales_return_items sales_return_items[]
}

model sales_return_items {
  id              Int     @id @default(autoincrement())
  sales_return_id Int
  product_id      Int
  quantity        Int
  amount          Decimal

  sales_return sales_returns @relation(fields: [sales_return_id], references: [id])
  product      products      @relation(fields: [product_id], references: [id])
}

model expense_types {
  id         Int      @id @default(autoincrement())
  type_name  String
  created_at DateTime

  expense_bills expense_bills[]
}

model expense_bills {
  id              Int      @id @default(autoincrement())
  expense_type_id Int
  invoice_date    DateTime
  receiver_name   String
  amount          Decimal
  remarks         String?
  created_at      DateTime @default(now())

  expense_type expense_types @relation(fields: [expense_type_id], references: [id])

  expense_payments expense_payments[]
}

model expense_payments {
  id              Int      @id @default(autoincrement())
  expense_bill_id Int
  payment_mode    String
  cash            Decimal
  amount          Decimal
  remarks         String?
  payment_date    DateTime

  expense_bill expense_bills @relation(fields: [expense_bill_id], references: [id])
}

model stock_adjustments {
  id              Int            @id @default(autoincrement())
  product_id      Int
  product_code    String
  product_name    String
  quantity        Int
  expire_date     DateTime?
  adjustment_type AdjustmentType
  created_at      DateTime       @default(now())

  product products @relation(fields: [product_id], references: [id])
}

model transaction_closing {
  id            Int      @id @default(autoincrement())
  closing_date  DateTime
  total_sales   Decimal
  total_expense Decimal
  cash_balance  Decimal
  created_by    Int
}

model cash_deposits {
  id           Int      @id @default(autoincrement())
  amount       Decimal
  deposit_date DateTime
  remarks      String?
}

model report_logs {
  id           Int      @id @default(autoincrement())
  report_name  String
  generated_by Int
  generated_at DateTime @default(now())

  user users @relation(fields: [generated_by], references: [id])
}

model audit_logs {
  id         Int      @id @default(autoincrement())
  user_id    Int
  action     String
  table_name String
  record_id  Int
  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id])
}
